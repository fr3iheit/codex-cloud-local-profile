{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"__CODEX_HOME__/hooks/pre_tool_use_policy.py\"",
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"__CODEX_HOME__/hooks/stop_continue.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
